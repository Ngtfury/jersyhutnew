# ===================================================================
# MATCHDAY — ENVIRONMENT VARIABLES TEMPLATE
# ===================================================================
# Copy this file to .env.local and fill in your actual credentials:

# Supabase Credentials (Required for database & storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-here

# Administrator Security (Required to protect /admin endpoint in production)
# Choose a strong secret password known only to you.
ADMIN_PASSWORD=your_super_secret_admin_password_here

# Optional: Custom encryption salt for admin session tokens
ADMIN_SESSION_SECRET=your_random_secret_salt_string_here

# Razorpay Payment Gateway (UPI, Cards, Netbanking)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Resend Email Service (Order Confirmation Emails)
RESEND_API_KEY=re_your_resend_api_key_here
STORE_NOTIFICATION_EMAIL=matchdayjerseysindia@gmail.com
RESEND_FROM_EMAIL="Matchday Jerseys <orders@matchdayjerseys.com>"
